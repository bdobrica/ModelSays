DATABASE_URL=postgres://postgres:postgres@localhost:5432/modelsays?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated lowercase BCP 47 language tags exposed in room creation.
AVAILABLE_LOCALES=en,ro
# Required in production; protects GET /metrics.
METRICS_TOKEN=
SHUTDOWN_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
DEFAULT_PREDICTION_MODEL=gpt-5.6-luna
DEFAULT_QUESTION_MODEL=gpt-5.6-luna
DEFAULT_JUDGE_MODEL=gpt-5.6-luna
ALLOWED_PREDICTION_MODELS=gpt-5.6-luna
ALLOWED_QUESTION_MODELS=gpt-5.6-luna
ALLOWED_JUDGE_MODELS=gpt-5.6-luna
MODEL_TIMEOUT_SECONDS=10
MODEL_MAX_ATTEMPTS=2
MODEL_MAX_CALLS_PER_GAME=20
MODEL_MAX_COST_USD_PER_GAME=0.10
MODEL_CAPTURE_RAW_RESPONSES=false
MODEL_RAW_RESPONSE_MAX_BYTES=4096
EVENT_POLL_INTERVAL_MS=250
EVENT_HEARTBEAT_SECONDS=15
EVENT_MAX_CONNECTIONS=100
EVENT_WRITE_TIMEOUT_SECONDS=5
AUTO_REVEAL_ENABLED=true
AUTO_REVEAL_GRACE_SECONDS=0
TRANSITION_POLL_INTERVAL_MS=250
TRANSITION_BATCH_SIZE=25
LIVINGROOM_REVEAL_PAUSE_SECONDS=8
# Leave empty unless the API is directly behind these exact reverse-proxy networks.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_IP_REQUESTS=600
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_REQUESTS=10
RATE_LIMIT_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_LOOKUP_REQUESTS=360
RATE_LIMIT_LOOKUP_WINDOW_SECONDS=60
RATE_LIMIT_JOIN_IP_REQUESTS=30
RATE_LIMIT_JOIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_JOIN_ROOM_REQUESTS=30
RATE_LIMIT_JOIN_ROOM_WINDOW_SECONDS=60
RATE_LIMIT_PLAYER_ACTION_REQUESTS=60
RATE_LIMIT_PLAYER_ACTION_WINDOW_SECONDS=60
RATE_LIMIT_GUESS_PLAYER_REQUESTS=12
RATE_LIMIT_GUESS_PLAYER_WINDOW_SECONDS=10
RATE_LIMIT_GUESS_ROOM_REQUESTS=180
RATE_LIMIT_GUESS_ROOM_WINDOW_SECONDS=60
RATE_LIMIT_EVENT_IP_REQUESTS=20
RATE_LIMIT_EVENT_IP_WINDOW_SECONDS=60
RATE_LIMIT_EVENT_ROOM_REQUESTS=20
RATE_LIMIT_EVENT_ROOM_WINDOW_SECONDS=60
PROVIDER_LIMIT_GLOBAL_REQUESTS=120
PROVIDER_LIMIT_GLOBAL_WINDOW_SECONDS=3600
PROVIDER_LIMIT_ROOM_REQUESTS=20
PROVIDER_LIMIT_ROOM_WINDOW_SECONDS=3600
# English whole-word moderation. Review locale and false positives before changing.
MODERATION_DENY_WORDS=nigger,faggot,kike
VITE_API_BASE_URL=http://localhost:8080
